# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package files and workspace configs
COPY package*.json ./
# Copy workspace package.json
COPY apps/api/package*.json ./apps/api/

# Install dependencies
RUN npm ci

COPY apps/api ./apps/api

# Build API
RUN npm run build -w @andpayments/api

# Only single stage build to include migration and seed scripts, configs, and source (needed for startup)
# # Production stage 
# FROM node:20-alpine

# WORKDIR /app

# Copy root package files
# COPY package*.json ./

# Copy workspace package.json
# COPY apps/api/package*.json ./apps/api/

# Install dependencies (including devDependencies for ts-node-based migrations on startup)
# RUN npm ci --ignore-scripts

# Copy built application from builder
# COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy migration and seed scripts, configs, and source (needed for startup)
COPY apps/api/db ./apps/api/db
COPY apps/api/src ./apps/api/src
COPY apps/api/drizzle.config.ts ./apps/api/
COPY apps/api/tsconfig.json ./apps/api/
COPY apps/api/tsconfig.seed.json ./apps/api/

EXPOSE 3000

# Run migrations and seeding on startup, then start the app
CMD ["sh", "-c", "npm run db:migrate -w @andpayments/api && npm run db:seed -w @andpayments/api && node apps/api/dist/main"]
